{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sonicly-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "3001", "--strictPort"],
      "port": 3001,
      "cwd": "frontend"
    },
    {
      "name": "sonicly-backend",
      "runtimeExecutable": "venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000,
      "cwd": "backend"
    },
    {
      "name": "sonicly-backend-local",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": ["DATABASE_URL=", "SUPABASE_URL=", "SUPABASE_SERVICE_ROLE_KEY=", "venv/bin/python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000,
      "cwd": "backend"
    }
  ]
}
